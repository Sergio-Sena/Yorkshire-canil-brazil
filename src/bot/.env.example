# WhatsApp / Meta
WHATSAPP_TOKEN=<token_do_whatsapp_business_api>
WHATSAPP_PHONE_ID=<phone_number_id>
WHATSAPP_APP_SECRET=<app_secret_do_meta_for_developers>  # usado para validar X-Hub-Signature-256
WEBHOOK_VERIFY_TOKEN=<token_secreto_para_verificar_webhook>

# AWS
AWS_REGION=us-east-1

# Bedrock
BEDROCK_MODEL_ID=anthropic.claude-sonnet-4-5

# Bedrock Guardrails
GUARDRAIL_ID=<guardrail_id_do_bedrock>
GUARDRAIL_VERSION=DRAFT  # trocar para versão publicada em produção

# DynamoDB
DYNAMODB_TABLE=yorkshire-bot-conversations

# SNS — alertas de negócio (Thiago: lead quente, fechamento)
SNS_TOPIC_ARN=<arn_do_topico_sns_business>

# SNS — alertas técnicos (Sergio: DLQ, erros críticos)
TECH_SNS_TOPIC_ARN=<arn_do_topico_sns_tech>

# Thiago — notificado diretamente no WhatsApp (sem SNS)
THIAGO_PHONE=<5511977118201>

# Sergio — alertas técnicos
SERGIO_PHONE=<5511999999999>

# SQS FIFO — webhook → processor
SQS_QUEUE_URL=<url_da_fila_sqs_fifo>.fifo

# Secrets Manager
SECRET_NAME=yorkshire-bot-secrets
